# Bucket and write configuration — uncomment one block at a time

# Source.Coop
# SOURCE_COOP_PUBLIC_URL=https://data.source.coop
# SOURCE_COOP_PREFIX_GEOMAD=auspatious/geomad-sids
# SOURCE_COOP_PREFIX_LULC=auspatious/lulc-sids
# BUCKET=us-west-2.opendata.source.coop
# Source.Coop write credentials. These time out so need to be reset often.
# SOURCE_COOP_AWS_ACCESS_KEY_ID=XXX
# SOURCE_COOP_AWS_SECRET_ACCESS_KEY=XXX
# SOURCE_COOP_AWS_SESSION_TOKEN=XXX


# Auspatious custom domain
SOURCE_COOP_PUBLIC_URL=
SOURCE_COOP_PREFIX_GEOMAD=
SOURCE_COOP_PREFIX_LULC=
BUCKET=data.ldn.auspatious.com
AUSPATIOUS_AWS_ACCESS_KEY_ID=XXX
AUSPATIOUS_AWS_SECRET_ACCESS_KEY=XXX

# DEP Staging
# SOURCE_COOP_PUBLIC_URL=
# SOURCE_COOP_PREFIX_GEOMAD=
# SOURCE_COOP_PREFIX_LULC=
# BUCKET=dep-public-staging
# SOURCE_COOP_AWS_ACCESS_KEY_ID=
# SOURCE_COOP_AWS_SECRET_ACCESS_KEY=
# SOURCE_COOP_AWS_SESSION_TOKEN=
# DEP_AWS_ACCESS_KEY_ID=XXX
# DEP_AWS_SECRET_ACCESS_KEY=XXX

# DEP Production
# SOURCE_COOP_PUBLIC_URL=
