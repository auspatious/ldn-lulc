{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["**", "!!**/dist", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
